# Database
DATABASE_URL="mysql://username:password@localhost:3306/Trustora"

# NextAuth.js
NEXTAUTH_URL="http://127.0.0.1:3000"
AUTH_URL="http://127.0.0.1:3000"
NEXTAUTH_URL_INTERNAL="http://127.0.0.1:3000"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Frontend API/Backend URLs
# Used for fetch/axios requests routed through /api (Laravel API routes)
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
# Used for OAuth redirects and stateful web routes (Laravel web.php routes)
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
# Required on the Next.js server for credentials login, including Preview/Production deploys.
# You can also use the LARAVEL_CLIENT_ID/LARAVEL_CLIENT_SECRET aliases.
PASSPORT_CLIENT_ID="your-passport-password-client-id"
PASSPORT_CLIENT_SECRET="your-passport-password-client-secret"
PASSPORT_SCOPE=""
PASSPORT_PROFILE_PATH="/auth/me"
PASSPORT_LOGOUT_PATH="/auth/logout"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPal
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"

# Email (SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"
FROM_EMAIL="noreply@Trustora.ro"

# File Upload
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Virus Scanning
VIRUSTOTAL_API_KEY="your-virustotal-api-key"

# Video Calls
ZOOM_API_KEY="your-zoom-api-key"
ZOOM_API_SECRET="your-zoom-api-secret"

# Commission Settings
PLATFORM_COMMISSION_RATE="0.05" # 5%

# Upstash Rate Limiting
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
UPSTASH_RATE_LIMIT_ENABLED="true"
# Set to "true" locally if you want requests to continue when Upstash is unreachable.
# Development also fails open by default in code to avoid blocking local work.
UPSTASH_RATE_LIMIT_FAIL_OPEN="false"
UPSTASH_RATE_LIMIT_AUTH_LOGIN_MAX="10"
UPSTASH_RATE_LIMIT_AUTH_LOGIN_WINDOW="1 m"
UPSTASH_RATE_LIMIT_AUTH_REGISTER_MAX="5"
UPSTASH_RATE_LIMIT_AUTH_REGISTER_WINDOW="10 m"
UPSTASH_RATE_LIMIT_AI_WRITE_MAX="20"
UPSTASH_RATE_LIMIT_AI_WRITE_WINDOW="1 m"
UPSTASH_RATE_LIMIT_AI_READ_MAX="60"
UPSTASH_RATE_LIMIT_AI_READ_WINDOW="1 m"
UPSTASH_RATE_LIMIT_ICONS_SEARCH_MAX="120"
UPSTASH_RATE_LIMIT_ICONS_SEARCH_WINDOW="1 m"
UPSTASH_RATE_LIMIT_BROADCAST_AUTH_MAX="90"
UPSTASH_RATE_LIMIT_BROADCAST_AUTH_WINDOW="1 m"
UPSTASH_RATE_LIMIT_API_GLOBAL_MAX="300"
UPSTASH_RATE_LIMIT_API_GLOBAL_WINDOW="1 m"
